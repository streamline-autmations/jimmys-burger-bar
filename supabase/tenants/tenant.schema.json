{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restaurant Direct tenant infrastructure",
  "description": "Server-side settings for one restaurant. Kept out of the site config so none of it ships in the browser bundle. Generate the SQL with npm run tenant:sql -- <slug>.",
  "type": "object",
  "required": [
    "slug",
    "supabaseProjectRef",
    "vercelProject",
    "phoneCountryCode",
    "webhooks",
    "reviewRequests"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Matches src/tenants/<slug>."
    },
    "supabaseProjectRef": {
      "type": "string",
      "description": "The project ref from the Supabase dashboard URL, or PLACEHOLDER until created."
    },
    "vercelProject": {
      "type": "string",
      "description": "The Vercel project name for the restaurant's live site."
    },
    "phoneCountryCode": {
      "type": "string",
      "pattern": "^[0-9]{1,3}$",
      "description": "Digits only, e.g. 27. Used to match 082... and +27 82... as the same guest."
    },
    "webhooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "booking",
        "review"
      ],
      "description": "n8n webhook URLs. null switches that notification off; it is logged as skipped, never an error.",
      "properties": {
        "order": {
          "type": [
            "string",
            "null"
          ]
        },
        "booking": {
          "type": [
            "string",
            "null"
          ]
        },
        "review": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    },
    "reviewRequests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "localTime"
      ],
      "properties": {
        "localTime": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Restaurant-local time the daily review emails go out, or null for none."
        },
        "optOutUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https://"
        }
      }
    },
    "payments": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "provider",
        "mode",
        "siteUrl"
      ],
      "properties": {
        "provider": {
          "const": "payfast"
        },
        "mode": {
          "enum": [
            "sandbox",
            "live"
          ]
        },
        "siteUrl": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "$comment": {
      "type": "string"
    },
    "rehearsal": {
      "type": "boolean"
    },
    "pushUrl": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^https://[a-z0-9]+\\.supabase\\.co/functions/v1/kitchen-push$",
      "description": "The kitchen-push Edge Function URL. Set it to send lock-screen alerts to opted-in staff phones when an order is paid; null or absent switches them off."
    },
    "kitchen": {
      "type": "object",
      "required": [
        "escalation"
      ],
      "properties": {
        "escalation": {
          "type": "object",
          "required": [
            "afterMinutes",
            "name"
          ],
          "properties": {
            "afterMinutes": {
              "type": "number",
              "minimum": 1
            },
            "name": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "payfastSecretNames": {
      "type": "object",
      "required": [
        "merchant_id",
        "merchant_key",
        "passphrase",
        "mode"
      ],
      "properties": {
        "merchant_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "merchant_key": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "passphrase": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "mode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
