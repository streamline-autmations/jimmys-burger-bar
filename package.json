{
  "name": "jimmys-burger-bar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "node --test tests/operations.test.mjs tests/database.test.mjs tests/tenants.test.mjs",
    "build:demo": "tsc -b && VITE_DEMO=1 vite build && VITE_DEMO=1 node scripts/check-build.mjs",
    "preview:demo": "vite preview --outDir dist-demo",
    "tenant:sql": "node scripts/tenant-sql.mjs",
    "menu:sql": "node scripts/tenant-sql.mjs",
    "db:fingerprint": "node scripts/db-fingerprint.mjs",
    "new-tenant": "node scripts/new-tenant.mjs",
    "check-tenant": "node scripts/check-tenant.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.25",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@eslint/js": "^9.25.0",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
